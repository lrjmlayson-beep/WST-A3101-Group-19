// ---------------------------------------------------------
// 2. ELEMENT REFERENCES
// ---------------------------------------------------------
const propertyList = document.getElementById("propertyList");
const propertyDetailWrapper = document.getElementById("propertyDetailWrapper");
const propertyDetailSection = document.getElementById("propertyDetailSection");
const backToResultsBtn = document.getElementById("backToResultsBtn");
const matchingPanel = document.getElementById("matchingPanel");

// ---------------------------------------------------------
// 3. VIEW DETAILS — show the expanded card for one property
// ---------------------------------------------------------
function showPropertyDetails(propertyId) {
  const data = PROPERTIES[propertyId];
  if (!data) return;

  // Fill in every element tagged data-field="..." inside the detail section
  Object.keys(data).forEach((fieldName) => {
    const el = propertyDetailSection.querySelector(`[data-field="${fieldName}"]`);
    if (el) el.textContent = data[fieldName];
  });

  // Track which property is currently expanded, and mirror it onto
  // the "Add to compare" button inside the detail view
  propertyDetailSection.dataset.propertyId = propertyId;
  const detailCompareBtn = document.getElementById("propertyDetailCompareBtn");
  detailCompareBtn.dataset.propertyId = propertyId;
  syncCompareButtonLabel(detailCompareBtn, propertyId);

  // Swap views
  propertyList.classList.add("is-hidden");
  propertyDetailWrapper.classList.remove("is-hidden");

  // Scroll the detail into view for convenience
  propertyDetailWrapper.scrollIntoView({ behavior: "smooth", block: "start" });
}

function hidePropertyDetails() {
  propertyDetailWrapper.classList.add("is-hidden");
  propertyList.classList.remove("is-hidden");
}

// Event delegation: one listener on the panel catches clicks on any
// current or future .view-details-btn, instead of wiring each button
// individually.
matchingPanel.addEventListener("click", (event) => {
  const viewBtn = event.target.closest(".view-details-btn");
  if (viewBtn) {
    showPropertyDetails(viewBtn.dataset.propertyId);
  }
});

backToResultsBtn.addEventListener("click", hidePropertyDetails);

// ---------------------------------------------------------
// 4. COMPARE SELECTION
// Tracks up to two selected property ids, keeps every matching
// "Add to compare" button (list view + detail view) in sync, and
// updates the "Select First/Second property" labels.
// ---------------------------------------------------------
let selectedPropertyIds = []; // e.g. ["dragon-tower", "likas-pinas"]

const selectFirstBtn = document.getElementById("selectFirstPropertyBtn");
const selectSecondBtn = document.getElementById("selectSecondPropertyBtn");
const swapBtn = document.getElementById("swapPropertiesBtn");

function syncCompareButtonLabel(button, propertyId) {
  const isSelected = selectedPropertyIds.includes(propertyId);
  button.dataset.selected = String(isSelected);
  button.textContent = isSelected ? "Remove from compare" : "Add to compare";
}

function refreshCompareUI() {
  // Update every compare button on the page (list cards + detail view)
  document.querySelectorAll(".add-compare-btn").forEach((btn) => {
    syncCompareButtonLabel(btn, btn.dataset.propertyId);
  });

  // Update the two slot buttons
  const name1 = selectedPropertyIds[0] ? PROPERTIES[selectedPropertyIds[0]].name.replace("Property Name: ", "") : null;
  const name2 = selectedPropertyIds[1] ? PROPERTIES[selectedPropertyIds[1]].name.replace("Property Name: ", "") : null;

  selectFirstBtn.textContent = name1 ? name1 : "Select First property +";
  selectSecondBtn.textContent = name2 ? name2 : "Select Second property +";
}

function toggleCompareSelection(propertyId) {
  const index = selectedPropertyIds.indexOf(propertyId);

  if (index > -1) {
    // Already selected — remove it
    selectedPropertyIds.splice(index, 1);
  } else if (selectedPropertyIds.length < 2) {
    // Room for another pick
    selectedPropertyIds.push(propertyId);
  } else {
    // Two are already selected — replace the first one
    selectedPropertyIds.shift();
    selectedPropertyIds.push(propertyId);
  }

  refreshCompareUI();
}

matchingPanel.addEventListener("click", (event) => {
  const compareBtn = event.target.closest(".add-compare-btn");
  if (compareBtn) {
    toggleCompareSelection(compareBtn.dataset.propertyId);
  }
});

swapBtn.addEventListener("click", () => {
  selectedPropertyIds.reverse();
  refreshCompareUI();
});

// Initialize labels on page load
refreshCompareUI();